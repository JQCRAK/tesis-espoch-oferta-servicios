# ════════════════════════════════════════════════════════════════
#  PLANTILLA DE VARIABLES DE ENTORNO — Portal de Graduados ESPOCH
#
#  Copia este archivo a ".env" y reemplaza los valores placeholder
#  con las credenciales reales:
#      cp .env.example .env
#
#  Todo el sistema corre LOCAL vía Docker Compose (backend,
#  frontend y MongoDB). El único servicio externo/en la nube es
#  Resend, usado únicamente para el envío de correos.
#
#  ⚠️  El archivo .env NUNCA se sube a git (está en .gitignore).
# ════════════════════════════════════════════════════════════════

# ══ Entorno ═════════════════════════════════════════════════════
NODE_ENV=production
PORT=8351

# ══ Base de datos — MongoDB local (contenedor Docker) ═══════════
# "mongo" es el nombre del servicio definido en docker-compose.yml.
# No se necesita usuario/contraseña: el contenedor no se expone
# fuera de la red interna de Docker.
MONGO_URI=mongodb://mongo:27017/portal_graduados_espoch

# ══ Seguridad ═══════════════════════════════════════════════════
# JWT_SECRET: clave larga (32+ caracteres) para firmar tokens.
# CRYPTO_SECRET: EXACTAMENTE 32 caracteres (encripta cédula y teléfono).
JWT_SECRET=cambia_esto_por_una_clave_larga_secreta_de_produccion
CRYPTO_SECRET=cambia_por_hex_de_exactamente_32_char

# ══ URL del frontend (para links en correos) ════════════════════
# En LOCAL: http://localhost:8350
# En SERVIDOR ESPOCH: http://<IP-o-dominio-del-servidor>:8350
FRONTEND_URL=http://localhost:8350

# ══ Correo — remitente institucional (Resend, único servicio en la nube) ══
# Debe usar un dominio verificado en Resend.
EMAIL_FROM="Portal Graduados ESPOCH <noreply@portalespoch.online>"
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ════════════════════════════════════════════════════════════════
#  FRONTEND (se usan al CONSTRUIR la imagen del frontend)
#  En LOCAL apunta a localhost. En la ESPOCH cambia a la IP/dominio
#  del servidor, por ejemplo: http://10.20.30.40:8351/api
# ════════════════════════════════════════════════════════════════
VITE_API_URL=http://localhost:8351/api
VITE_BASE_URL=http://localhost:8351

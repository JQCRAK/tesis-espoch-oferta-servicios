# ════════════════════════════════════════════════════════════════
#  PLANTILLA DE VARIABLES DE ENTORNO — Portal de Graduados ESPOCH
#
#  Copia este archivo a ".env" y reemplaza los valores placeholder
#  con las credenciales reales:
#      cp .env.example .env
#
#  ⚠️  El archivo .env NUNCA se sube a git (está en .gitignore).
# ════════════════════════════════════════════════════════════════

# ══ Entorno ═════════════════════════════════════════════════════
NODE_ENV=production
PORT=4000

# ══ Base de datos — MongoDB Atlas ═══════════════════════════════
# Formato: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?appName=<app>
# La contraseña debe estar URL-encoded si tiene caracteres especiales.
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/?appName=portal-graduados

# ══ Seguridad ═══════════════════════════════════════════════════
# JWT_SECRET: clave larga (32+ caracteres) para firmar tokens.
# CRYPTO_SECRET: EXACTAMENTE 32 caracteres (encripta cédula y teléfono).
JWT_SECRET=cambia_esto_por_una_clave_larga_secreta_de_produccion
CRYPTO_SECRET=cambia_por_hex_de_exactamente_32_char

# ══ URL del frontend (para links en correos) ════════════════════
# En LOCAL: http://localhost
# En SERVIDOR ESPOCH: http://<IP-o-dominio-del-servidor>
FRONTEND_URL=http://localhost

# ══ Correo — remitente institucional ════════════════════════════
# Debe usar un dominio verificado en Resend.
EMAIL_FROM="Portal Graduados ESPOCH <noreply@portalespoch.online>"

# ══ Cloudinary — almacenamiento de imágenes ═════════════════════
# Crear cuenta en https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ══ Resend — envío de correos ═══════════════════════════════════
# API Key en https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ════════════════════════════════════════════════════════════════
#  FRONTEND (se usan al CONSTRUIR la imagen del frontend)
#  En LOCAL apunta a localhost. En la ESPOCH cambia a la IP/dominio
#  del servidor, por ejemplo: http://10.20.30.40:4000/api
# ════════════════════════════════════════════════════════════════
VITE_API_URL=http://localhost:4000/api
VITE_BASE_URL=http://localhost:4000
